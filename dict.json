  "patterns": [
    {
      "regex": "^(\\d+)\\s+files?\\s+changed$",
      "replace": "$1 个文件已更改"
    },
    {
      "regex": "^(\\d+)\\s+agents?\\s+running$",
      "replace": "正在运行 $1 个智能体"
    },
    {
      "regex": "^(\\d+)\\s+tasks?\\s+running$",
      "replace": "正在运行 $1 个任务"
    },
    {
      "regex": "^(\\d+)\\s+lines?$",
      "replace": "$1 行"
    },
    {
      "regex": "^Version\\s+([0-9][0-9A-Za-z.\\-]+)$",
      "replace": "版本 $1"
    },
    {
      "regex": "^Show more \\((\\d+)\\)$",
      "replace": "展开更多 ($1)"
    },
    {
      "regex": "^See all \\((\\d+)\\)$",
      "replace": "查看全部 ($1)"
    },
    {
      "regex": "^Generation Steps \\((\\d+)\\)$",
      "replace": "生成步骤 ($1)"
    },
    {
      "regex": "^Show submitted \\((\\d+)\\)$",
      "replace": "显示已提交 ($1)"
    },
    {
      "regex": "^Resume (\\d+) comment drafts?$",
      "replace": "恢复 $1 条评论草稿"
    },
    {
      "regex": "^Handler #(\\d+)$",
      "replace": "处理器 #$1"
    },
    {
      "regex": "^Active environment:\\s*(.+)$",
      "replace": "当前环境：$1"
    }
  ]
